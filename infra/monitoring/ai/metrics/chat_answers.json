{
  "name": "exportmate_ai/chat_answers",
  "description": "Assistant answers by outcome (ok, needs_review, max_steps, error) and policy version.",
  "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"${SERVICE}\" AND jsonPayload.message=\"chat.completed\"",
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "INT64",
    "labels": [
      {
        "key": "status",
        "valueType": "STRING"
      },
      {
        "key": "policy_version",
        "valueType": "STRING"
      }
    ]
  },
  "labelExtractors": {
    "status": "EXTRACT(jsonPayload.status)",
    "policy_version": "EXTRACT(jsonPayload.policyVersion)"
  }
}
