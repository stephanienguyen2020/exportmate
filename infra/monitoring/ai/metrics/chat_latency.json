{
  "name": "exportmate_ai/chat_latency",
  "description": "Time to a complete assistant answer.",
  "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"${SERVICE}\" AND jsonPayload.message=\"chat.completed\"",
  "valueExtractor": "EXTRACT(jsonPayload.latencyMs)",
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "DISTRIBUTION",
    "unit": "ms"
  },
  "bucketOptions": {
    "exponentialBuckets": {
      "numFiniteBuckets": 16,
      "growthFactor": 1.6,
      "scale": 250
    }
  }
}
