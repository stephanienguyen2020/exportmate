# Copy to .env for local development.
DATABASE_URL=postgresql+psycopg://exportmate:exportmate@127.0.0.1:5433/exportmate
TEST_DATABASE_URL=postgresql+psycopg://exportmate:exportmate@127.0.0.1:5433/exportmate_test
# Host port for the Docker Postgres in docker-compose.yml. If 5433 is taken (e.g. by a
# locally installed Postgres), change it here and in both URLs above.
DB_PORT=5433

# "dev" accepts tokens like "dev:lan@example.com". Never allowed when ENV=production.
AUTH_MODE=dev
ENV=development
FIREBASE_PROJECT_ID=exportmate-app

# Uploaded documents (also locally). Needs `gcloud auth application-default login`.
REGULATION_DOCUMENT_BUCKET=exportmate-regulation-documents-dev

# Emailed order reports. Empty key: sandbox, nothing is delivered (fine for local work).
RESEND_API_KEY=
REPORT_EMAIL_FROM=ExportMate <reports@exportmate.app>
# Company reports read News watch alerts from the AI service (ai/server, npm run dev).
AI_SERVICE_URL=http://127.0.0.1:8080

# Gemini on Vertex AI for the AI steps (reading supplier documents, drafting requirements, HS
# code and what-if suggestions, suggested solutions, supplier messages, HS heading vectors).
# Locally, the AI service's project (PROJECT_ID in ai/server, default exportmate-app); needs
# `gcloud auth application-default login`. Empty: those steps answer 503 ai_not_configured.
GOOGLE_CLOUD_PROJECT=exportmate-app

ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://exportmate.vercel.app

# Logging: text locally, JSON (for Cloud Logging) when ENV=production unless set here.
LOG_LEVEL=INFO
# LOG_FORMAT=json

# Suppliers and sites this close (km) to an observed flood extent get a check-in prompt.
FLOOD_CHECK_RADIUS_KM=25
