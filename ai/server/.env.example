# Copy to .env for local development: `npm run dev` (and ../../dev.sh) read it if it exists.
# Real environment variables win over it. Needs `gcloud auth application-default login` once.

# Project with the AI service's Firestore, RAG Engine corpora and Gemini (default
# skilful-scarab-511320-q9). Keep GOOGLE_CLOUD_PROJECT in backend/.env the same, so the backend's
# AI steps use the same project.
# PROJECT_ID=skilful-scarab-511320-q9

# Agent Platform Sessions and Memory Bank (Account › What the assistant remembers). Unset: chat
# sessions are kept in memory and nothing is remembered. Use a development instance, never the
# deployed one; this prints the development instance's name (in GOOGLE_CLOUD_PROJECT, default
# exportmate-app):
#   uv run --project platform python platform/runtime.py show --name exportmate-agents-dev
# Chat fails while the instance can't be reached, so remove the line if you lose access to it.
# AGENT_RUNTIME=projects/<project>/locations/asia-southeast1/reasoningEngines/<id>

# Company backend the assistant reads orders and playbook rules from.
# BACKEND_URL=http://127.0.0.1:8000
