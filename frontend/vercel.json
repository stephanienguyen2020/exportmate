{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "functions": {
    "api/backend.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/backend?path=:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://exportmate-ai-288740653400.asia-southeast1.run.app/api/:path*"
    }
  ]
}
