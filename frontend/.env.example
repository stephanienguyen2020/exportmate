# Firebase Console > Project settings > Your apps > Web app SDK configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=skilful-scarab-511320-q9.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=skilful-scarab-511320-q9
VITE_FIREBASE_APP_ID=

# Deployed FastAPI origin (no /api/v1), e.g. https://exportmate-backend-<hash>-as.a.run.app.
# Read by the Vercel /api/v1 proxy (api/backend.ts) and by the Vite dev-server proxy.
# With VITE_AUTH_MODE=dev the dev server always uses the local backend on :8000 instead.
BACKEND_URL=

# Optional: AI service origin for the Vite dev-server /api proxy (default http://127.0.0.1:8080).
# AI_SERVICE_URL=

# Optional direct backend URL including /api/v1 (requires backend CORS).
# Leave unset to use the Vercel proxy, or the Vite localhost:8000 proxy in dev.
# VITE_BACKEND_API_URL=https://your-backend.example/api/v1

# Local Vite development only; production builds always require Firebase.
# Pair with AUTH_MODE=dev in backend/.env. Sign in as lan@example.com after seeding.
# VITE_AUTH_MODE=dev
