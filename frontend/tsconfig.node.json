{
  // Type checks what runs in Node rather than the browser: the build and test configs and the
  // Playwright specs (Playwright only strips their types). `npm run typecheck` runs it.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "types": ["node", "vite/client"]
  },
  "include": ["tests/**/*.ts", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
